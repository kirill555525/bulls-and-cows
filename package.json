{
  "name": "bulls-and-cows",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "serve": "http-server . -c-1 -p 8080",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "prepare": "husky",
    "build:site": "npm run build && node --input-type=module -e \"import { cpSync, mkdirSync, rmSync } from 'node:fs'; rmSync('site', { recursive: true, force: true }); mkdirSync('site'); for (const path of ['index.html', 'styles.css', 'dist']) cpSync(path, 'site/' + path, { recursive: true });\""
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "http-server": "14.1.1",
    "husky": "9.1.7",
    "jsdom": "26.1.0",
    "lint-staged": "16.2.6",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "4.0.8"
  }
}
